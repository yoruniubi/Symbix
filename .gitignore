# ── Secrets & local runtime data (never commit) ──
.env
.env.*
!.env.example

# AI provider credentials
backend/Symbix_sdk/config/providers.json
# Voice engine config (may contain cloud API keys: openai / xfyun ..., never commit)
backend/Symbix_sdk/config/voice_config.json
# MCP OAuth tokens (access/refresh token + client registration, never commit)
backend/Symbix_sdk/config/mcp_oauth.json
backend/Symbix_sdk/config/mcp_oauth.json.tmp
backend/Symbix_sdk/config/mcp_config.json
# TTS/STT local model & binaries (large, downloaded separately)
backend/Symbix_sdk/tts/model
backend/Symbix_sdk/stt/bin
backend/Symbix_sdk/stt/model
# sense-voice exe 运行时自动生成的特征缓存(缺失会自动重建)
backend/Symbix_sdk/stt/fbank_lfr_cmvn_feature.json
fbank_lfr_cmvn_feature.json
# User-defined local tool risk overrides
backend/Symbix_sdk/config/risk_overrides.json
# Per-session trust state (mode + permanent grants, runtime data)
backend/Symbix_sdk/config/risk_trust.json
# Conversation memory / SQLite
**/*.db
**/*.db-journal
**/*.db-shm
**/*.db-wal
**/*.sqlite
**/*.sqlite3
# Checkpoint blob snapshots (user file content, never commit)
backend/Symbix_sdk/checkpoint_blobs/

# Chat exports & uploads
backend/Symbix_sdk/skill/installed_skills/
backend/Symbix_sdk/config/history_list/
backend/uploads/
backend/Symbix_sdk/memory/checkpoint_blobs/
uploads/

# MCP local install cache / node modules under backend if any
backend/**/node_modules/

# Playwright MCP 运行时输出（console 日志、page snapshot yml 等，按时间戳写）
backend/.playwright-mcp/

# Python
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.venv/
venv/
.env/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# IDE / OS
.idea/
.vscode/*
!.vscode/extensions.json
.DS_Store
Thumbs.db
*.swp
*.swo

# Logs / temp
*.log
*.tmp
.cache/

# detect-secrets / pre-commit local
# (baseline IS tracked)
